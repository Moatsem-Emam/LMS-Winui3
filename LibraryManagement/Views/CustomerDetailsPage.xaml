<Page x:Class="LibraryManagement.Views.CustomerDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      Background="#F3F4F6" Padding="20">

    <StackPanel Spacing="20">
        <!-- 🔙 زر الرجوع -->
        <Button Content="⬅ Back" Click="BackButton_Click" Width="120" Height="40" 
                Background="#6B7280" Foreground="White"
                CornerRadius="8" FontWeight="SemiBold"/>

        <!-- 👤 اسم العميل -->
        <TextBlock Text="{Binding Customer.Name}" FontSize="30" FontWeight="Bold" Foreground="#1F2937"  
                   HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <!-- 📚 الكتب المستعارة -->
        <Border Background="White" CornerRadius="12" Padding="15" 
                BorderBrush="#D1D5DB" BorderThickness="1" >
            <StackPanel>
                <TextBlock Text="📚 Borrowed Books" FontSize="20" FontWeight="SemiBold" 
                           Foreground="#374151" Margin="0,0,0,10"/>
                <controls:DataGrid ItemsSource="{Binding Customer.BorrowedBooks}" AutoGenerateColumns="False"
                                   GridLinesVisibility="Vertical" HeadersVisibility="Column"
                                   AlternatingRowBackground="#F9FAFB" RowBackground="White"
                                   BorderThickness="0" CornerRadius="6" IsReadOnly="True">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="📖 Title" Binding="{Binding Title}" Width="*"/>
                        <controls:DataGridTextColumn Header="✍️ Author" Binding="{Binding Author}" Width="*"/>
                        <controls:DataGridTextColumn Header="📅 Due Date" Binding="{Binding DueDate}" Width="*"/>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </StackPanel>
        </Border>

        <!-- 📖 الحجوزات -->
        <Border Background="White" CornerRadius="12" Padding="15" 
                BorderBrush="#D1D5DB" BorderThickness="1" >
            <StackPanel>
                <TextBlock Text="📖 Reserved Books" FontSize="20" FontWeight="SemiBold" 
                           Foreground="#374151" Margin="0,0,0,10"/>
                <controls:DataGrid ItemsSource="{Binding Reservations}" AutoGenerateColumns="False"
                                   GridLinesVisibility="Vertical" HeadersVisibility="Column"
                                   AlternatingRowBackground="#F9FAFB" RowBackground="White"
                                   BorderThickness="0" CornerRadius="6" IsReadOnly="True">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="📖 Title" Binding="{Binding Book.Title}" Width="*"/>
                        <controls:DataGridTextColumn Header="✍️ Author" Binding="{Binding Book.Author}" Width="*"/>
                        <controls:DataGridTextColumn Header="📆 Reserved On" Binding="{Binding ReservationDate}" Width="*"/>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
