<Page  
    x:Class="LibraryManagement.Views.CustomersPage"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:vm="using:LibraryManagement.ViewModels"  
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"  
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">

    <Page.DataContext>
        <vm:CustomerViewModel />
    </Page.DataContext>

    <Grid Background="#F3F4F6" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 📌 عنوان الصفحة -->
        <TextBlock Text="Customers Management" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"  
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- 📌 إضافة عميل جديد -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10" Margin="0,10,0,10" BorderBrush="#D1D5DB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBox Text="{Binding Name, Mode=TwoWay}" Width="180" Height="40" PlaceholderText="👤 Customer Name" />
                <Button Content="➕ Add Customer" Width="140" Height="40" Background="#3498DB" Foreground="White"  
                        Command="{Binding AddCustomerCommand}" />
            </StackPanel>
        </Border>

        <!-- 📌 قائمة العملاء -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,0">
            <controls:DataGrid x:Name="CustomersGrid" 
                               AutoGenerateColumns="False" 
                               ItemsSource="{Binding Customers}" 
                               IsReadOnly="True"
                               HeadersVisibility="Column"
                               AlternatingRowBackground="#F3F4F6"
                               GridLinesVisibility="None"
                               RowBackground="White"
                               BorderThickness="0"
                               FontSize="14"
                               RowHeight="45"
                               ColumnHeaderHeight="40"
                               BorderBrush="Transparent"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch">

                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="👤 Name" Binding="{Binding Name}" Width="*" />

                    <controls:DataGridTemplateColumn Header="❌ Delete">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="30" Height="30" Background="OrangeRed" Foreground="White"  
                                        Click="RemoveButton_Click"  
                                        HorizontalAlignment="Center"  
                                        VerticalAlignment="Center"  
                                        Padding="0" CornerRadius="6">
                                    <SymbolIcon Symbol="Delete" Width="14" Height="16"/>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <controls:DataGridTemplateColumn Header="Details">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📄" Width="30" Height="30"
                                        Background="#10B981" Foreground="White"
                                        Click="DetailButton_Click"  
                                        HorizontalAlignment="Center"  
                                        VerticalAlignment="Center"  
                                        Padding="0" CornerRadius="6" />
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>
    </Grid>
</Page>
