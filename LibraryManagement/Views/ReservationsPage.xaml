<Page   
    x:Class="LibraryManagement.Views.ReservationsPage"   
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"   
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"   
    xmlns:vm="using:LibraryManagement.ViewModels"   
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"   
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"> 
 
    <Page.DataContext> 
        <vm:ReservationViewModel /> 
    </Page.DataContext> 
 
    <Grid Background="#F3F4F6" Padding="20"> 
        <Grid.RowDefinitions> 
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/> 
        </Grid.RowDefinitions> 
 
        <!-- 📌 عنوان الصفحة --> 
        <TextBlock Text="Reservations Management" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"   
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <!-- 📥 زر تحميل التقرير -->
        <Button Content="📄 Export Report" Width="160" Height="40"
        Background="#2ECC71" Foreground="White"
        HorizontalAlignment="Right"
        Click="ExportReport_Click"
        Margin="0,0,0,10"
        Grid.Row="0"/>
        
        <!-- 📊 إحصائيات الحجوزات -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Border Background="#FDE68A" Padding="20" CornerRadius="15" Width="200" Height="100" BorderBrush="#FACC15" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📦 Total Reservations" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalReservations}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#BFDBFE" Padding="20" CornerRadius="15" Width="200" Height="100" BorderBrush="#60A5FA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📖 Most Reserved Book" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MostReservedBook}" FontSize="16" TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Border>

            <Border Background="#C7F9CC" Padding="20" CornerRadius="15" Width="200" Height="100" BorderBrush="#34D399" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="👤 Top Reserver" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TopCustomer}" FontSize="16" TextWrapping="WrapWholeWords"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 📌 مربع البحث والتصفية -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" Margin="0,0,0,10" BorderBrush="#D1D5DB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="220" Height="40" PlaceholderText="🔍 Search..."  
                 TextChanged="SearchBox_TextChanged" 
                 Text="{Binding SearchText, Mode=TwoWay}"/>

                <!-- بحث حسب -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                    <RadioButton x:Name="SearchByTitle" Content="By Title" IsChecked="True"  
                         Checked="SearchOptionChanged"/>
                    <RadioButton x:Name="SearchByAuthor" Content="By Name" Margin="10,0,0,0" 
                         Checked="SearchOptionChanged"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- 📌 إضافة حجز جديد -->
        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="10" Margin="0,10,0,10" BorderBrush="#D1D5DB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <ComboBox Width="200" Height="40" ItemsSource="{Binding AvailableBooks}" DisplayMemberPath="Title"   
                  SelectedItem="{Binding SelectedBook, Mode=TwoWay}" PlaceholderText="📖 Select Book" />

                <ComboBox Width="200" Height="40" ItemsSource="{Binding Customers}" DisplayMemberPath="Name"   
                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" PlaceholderText="👤 Select Customer" 
                  IsEnabled="{Binding IsCustomerComboBoxEnabled}"/>

                <Button Content="➕ Add Reservation" Width="150" Height="40" Background="#3498DB" Foreground="White" Command="{Binding AddReservationCommand}"/>
            </StackPanel>
        </Border>

        <!-- 📌 عرض قائمة الحجوزات --> 
        <Border Grid.Row="4" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,0"> 
            <controls:DataGrid x:Name="ReservationsGrid" AutoGenerateColumns="False"   
                               ItemsSource="{Binding FilteredReservations}"   
                                IsReadOnly="True"
                                HeadersVisibility="Column"
                                AlternatingRowBackground="#F3F4F6"
                                GridLinesVisibility="None"
                                RowBackground="White"
                                BorderThickness="0"
                                FontSize="14"
                                RowHeight="45"
                                ColumnHeaderHeight="40"
                                BorderBrush="Transparent"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"> 
                <controls:DataGrid.Columns> 
                    <controls:DataGridTextColumn Header="📖 Title" Binding="{Binding Book.Title}" Width="*" /> 
                    <controls:DataGridTextColumn Header="👤 Reserved By" Binding="{Binding Customer.Name}" Width="*" /> 
                    <controls:DataGridTextColumn Header="📅 Reservation Date" Binding="{Binding ReservationDate}" Width="*" /> 
 
                    <controls:DataGridTemplateColumn Header="❌ Delete"> 
                        <controls:DataGridTemplateColumn.CellTemplate> 
                            <DataTemplate> 
                                <Button Width="30" Height="30" Background="OrangeRed" Foreground="White"   
                                        Click="RemoveButton_Click"
                                        HorizontalAlignment="Center"   
                                        VerticalAlignment="Center"   
                                        Padding="0"> 
                                    <SymbolIcon Symbol="Delete" Width="14" Height="16"/> 
                                </Button> 
                            </DataTemplate> 
                        </controls:DataGridTemplateColumn.CellTemplate> 
                    </controls:DataGridTemplateColumn> 
 
                </controls:DataGrid.Columns> 
            </controls:DataGrid> 
        </Border> 
 
    </Grid> 
</Page>
